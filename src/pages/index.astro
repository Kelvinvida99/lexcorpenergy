---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Obra from '../components/Obra.astro';
import Servicios from '../components/Servicios.astro';
import Proceso from '../components/Proceso.astro';
import Proyectos from '../components/Proyectos.astro';
import Ficha from '../components/Ficha.astro';
import Preguntas from '../components/Preguntas.astro';
import Cotizacion from '../components/Cotizacion.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
---
<Base
  title="LexCorp Energy · Energía solar para tu casa y tu negocio"
  description="Diseño, instalación y mantenimiento de sistemas solares fotovoltaicos para viviendas, negocios e industrias en República Dominicana. Calcula tu sistema y pide tu cotización."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Obra />
    <Servicios />
    <Proceso />
    <Proyectos />
    <Ficha />
    <Preguntas />
    <Cotizacion />
  </main>
  <Footer />
  <WhatsApp />
</Base>
