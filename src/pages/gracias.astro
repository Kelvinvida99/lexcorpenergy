---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Solicitud recibida · LexCorp Energy" description="Recibimos tu solicitud de cotización.">
  <Header />
  <main id="contenido" class="wrap gracias">
    <h1>Recibimos tu solicitud.</h1>
    <p>Te contactaremos para agendar la visita técnica.</p>
    <a class="btn" href="/">Volver al inicio</a>
  </main>
  <Footer />
</Base>

<style>
  .gracias { padding-block: clamp(96px, 14vw, 200px); display: grid; gap: 24px; justify-items: start; }
  .gracias h1 { font-size: var(--fs-h1); color: var(--pet); }
  .gracias p { font-size: var(--fs-lead); color: var(--ink-soft); }
</style>
