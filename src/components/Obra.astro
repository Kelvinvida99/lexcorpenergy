---
import { Picture } from 'astro:assets';
import { portada } from '../lib/obras';
---
<section class="obra" aria-label="Del plano a la obra">
  <Picture src={portada.img} alt={portada.alt} formats={['avif', 'webp']}
    widths={[640, 1024, 1600, 2400]} width={2400} quality={70} sizes="100vw" class="obra__img" />
  <div class="obra__tag">
    <p class="obra__big">Del plano a la azotea.</p>
    <p class="dim">Obra de LexCorp Energy · azotea comercial · enero 2024</p>
  </div>
</section>

<style>
  .obra {
    position: relative;
    height: clamp(420px, 78vh, 860px);
    overflow: hidden;
    background: var(--pet-deep);
  }
  .obra :global(.obra__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .obra__tag {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    max-width: min(560px, calc(100% - 2 * var(--gutter)));
    padding: 20px 24px;
    background: var(--pet);
    color: var(--on-pet);
  }
  .obra__tag .dim { color: var(--tq-light); margin-top: 8px; }
  .obra__big {
    font-size: var(--fs-h3);
    font-weight: 850;
    font-stretch: 78%;
    line-height: 1;
  }
</style>
